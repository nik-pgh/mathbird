# Versioning & build
.git
.gitignore

# Python
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.pyc
backend/uv.lock

# Uploaded PDFs (runtime data, never in image)
backend/uploads/

# Frontend (separate build pipeline)
frontend/

# Docs & assets
docs/
*.md
!backend/README.md

# IDE
.vscode
.idea

# OS
.DS_Store
Thumbs.db

# Env (secrets must be injected at runtime, never baked into image)
.env
.env.*
!.env.example
