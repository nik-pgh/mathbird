# ──────────────────────────────────────────────────────────────────────────────
# LiveKit Cloud
# Get these from https://cloud.livekit.io  →  Settings → Keys
# ──────────────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Provider selection — swap any of these without touching code
# Options:
#   STT_PROVIDER:  deepgram | openai
#   LLM_PROVIDER:  openai
#   TTS_PROVIDER:  cartesia | elevenlabs | openai
#   VAD_PROVIDER:  silero
# ──────────────────────────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia
VAD_PROVIDER=silero

# Per-provider model overrides (optional — sensible defaults in code)
STT_MODEL=nova-3
LLM_MODEL=gpt-4o-mini

# TTS_MODEL / TTS_VOICE are provider-specific. Defaults below are for Cartesia.
# If you switch TTS_PROVIDER, replace BOTH with values from the new provider:
#   cartesia    → model: sonic-2          voice: any Cartesia voice ID
#   elevenlabs  → model: eleven_turbo_v2_5 (or v3) voice: any ElevenLabs voice ID
#                 (e.g. Rachel: 21m00Tcm4TlvDq8ikWAM)
#   openai      → model/voice ignored; OpenAI TTS uses voice="alloy" in code
TTS_MODEL=sonic-2
TTS_VOICE=794f9389-aac1-45b6-b726-9d9369183238
TTS_LANGUAGE=ko

# ──────────────────────────────────────────────────────────────────────────────
# Provider API keys (only the ones you've selected above need to be set)
# ──────────────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Backend HTTP API (PDF upload + LiveKit token issuance)
# ──────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Storage backend for uploaded PDFs
# Options: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads

# S3 (only required when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# RAG (math textbook retrieval)
# Options:
#   RAG_PROVIDER: null | llamaindex_qdrant
#   PARSER_PROVIDER: llamaparse
#   RERANKER_PROVIDER: none
#   RAG_INGESTION_MODE: sync
# ──────────────────────────────────────────────────────────────────────────────
RAG_PROVIDER=null
PARSER_PROVIDER=llamaparse
RERANKER_PROVIDER=none
RAG_INGESTION_MODE=sync
RAG_TOP_K=4

# LlamaParse / LlamaCloud
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic
LLAMAPARSE_VERSION=latest

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mathbird_documents

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────────────────────────────────────
# Whiteboards (handwriting → text interpretation for the student's board)
# Options:
#   BOARD_READER: null | openai_vision
# Setting BOARD_READER=openai_vision turns the feature on; "null" makes the
# student board a no-op for the agent (still drawable, just not interpreted).
# ──────────────────────────────────────────────────────────────────────────────
BOARD_READER=null
BOARD_READER_MODEL=gpt-4o-mini
BOARD_READER_INTERVAL_SECONDS=2.0
BOARD_READER_MAX_IMAGE_DIM=512

# ── AiBoard extractor (second LLM that watches the agent's spoken sentences
# and publishes board items per sentence). When enabled, the extractor is the
# SINGLE source of board writes — the agent LLM no longer has direct tools
# for AiBoard updates.
#
#   null         — no-op default. AiBoard stays blank.
#   openai       — uses OPENAI_API_KEY + gpt-4o-mini (or BOARD_EXTRACTOR_MODEL)
BOARD_EXTRACTOR=null
BOARD_EXTRACTOR_MODEL=gpt-4o-mini
BOARD_EXTRACTOR_TIMEOUT_SECONDS=2.0

# ──────────────────────────────────────────────────────────────────────────────
# Observability (Arize Phoenix)
# Local Phoenix: leave endpoint/key blank and run `uv run phoenix serve`.
# Phoenix Cloud: use the space hostname from Settings, e.g.
#   PHOENIX_ENDPOINT=https://app.phoenix.arize.com/s/<space-name>
# ──────────────────────────────────────────────────────────────────────────────
PHOENIX_ENABLED=false
PHOENIX_PROJECT=mathbird
PHOENIX_ENDPOINT=
PHOENIX_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Agent persona
# The system prompt lives in a YAML file (default: backend/personas/default.yaml).
# Edit that file to change the persona, or point PERSONA_FILE at a different one.
# ──────────────────────────────────────────────────────────────────────────────
# PERSONA_FILE=./personas/default.yaml

# ──────────────────────────────────────────────────────────────────────────────
# Frontend
# Copy these to frontend/.env.local (Vite requires the VITE_ prefix)
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
