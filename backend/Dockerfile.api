# HTTP API image (FastAPI). Deployed to Fly.io — see fly.toml for the
# runtime config. The LiveKit agent worker is a separate process deployed
# to LiveKit Cloud Agents (see Dockerfile + livekit.toml).
#
# Same Python package as the agent, different entrypoint and a leaner
# build (no plugin-model prewarming).

FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_SYSTEM_PYTHON=1

WORKDIR /app

COPY pyproject.toml ./
COPY app/ ./app/
COPY personas/ ./personas/

# Phoenix/OpenInference are core deps (api/main.py calls setup_phoenix() at import).
RUN uv pip install -e .

RUN useradd -m -u 1000 app && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
