# Frontend env (Vite requires VITE_ prefix to expose to client code)
VITE_API_BASE_URL=http://localhost:8000

# Show "Try as guest" button on the login page.
# Requires GUEST_SAMPLE_DOC_ID to be set on the backend.
VITE_GUEST_ENABLED=false

# LiveKit WebSocket URL comes from POST /api/token — no VITE_LIVEKIT_URL needed.
